/dts-v1/;
#include "cv180x_base_riscv.dtsi"
#include "cv180x_asic_qfn.dtsi"
#include "cv180x_asic_sd.dtsi"
#include "cv180x_default_memmap.dtsi"

/ {
	model = "Milk-V Duo";
};

&mipi_rx{
	snsr-reset = <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>;
};

&spi2 {
	status = "okay";

	spidev@0 {
		status = "okay";
	};
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&i2c1 {
       status = "okay";
       clock-frequency = <100000>;
};

&i2s2 {
	status = "okay";
	#sound-dai-cells = <0>;
};

&i2s0 {
	status = "okay";
	#sound-dai-cells = <0>;
};


/ {
	/* codecs */
	max98357a: max98357a {
		#sound-dai-cells = <0>;
		compatible = "maxim,max98357a";
		status = "okay";
	};

	wm8782: wm8782 {
		#sound-dai-cells = <0>;
		compatible = "wlf,wm8782";
		status = "okay";
	};

	/* sound_extout use external dac */
	//sound_extout {
	//	compatible = "cvitek,cv1835-max98357a";
	//	cvi,card_name = "cv1835_max98357a";
	//};

	//sound_extout {
	//	compatible = "simple-audio-card";
	//	simple-audio-card,name = "Simple-Card MAX98357a";
	//	simple-audio-card,format = "i2s";
	//	simple-audio-card,widgets =
	//		"Speaker Out", "SPKR";
	//	simple-audio-card,routing =
	//		"Speaker", "SPKR";
	//	simple-audio-card,cpu {
	//		sound-dai = <&i2s2 0>;
	//	};
	//	simple-audio-card,codec {
	//		sound-dai = <&max98357a>;
	//	};
	//};

	/* sound_extin use external adc */
	//sound_extin {
	//	compatible = "cvitek,cv1835-wm8782";
	//	cvi,card_name = "cv1835_wm8782";
	//};

	//sound_extin {
	//	compatible = "simple-audio-card";
	//	simple-audio-card,name = "Simple-Card WM8782";
	//	simple-audio-card,format = "i2s";
	//	simple-audio-card,widgets =
	//		"Line In", "Line";
	//	simple-audio-card,routing =
	//		"Capture", "Line";
	//	simple-audio-card,cpu {
	//		sound-dai = <&i2s1 0>;
	//	};
	//	simple-audio-card,codec {
	//		sound-dai = <&wm8782>;
	//	};
	//};

	sound_ext {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Simple-Card External I2S";
		
		simple-audio-card,dai-link@0 {		/* I2S - Output */
			format = "i2s";
			cpu {
				sound-dai = <&i2s2 0>;
			};
			codec {
				sound-dai = <&max98357a>;
			};
		};
		
		simple-audio-card,dai-link@1 {		/* I2S - Input */
			format = "i2s";
			cpu {
				sound-dai = <&i2s1 0>;
			};
			codec {
				sound-dai = <&wm8782>;
			};
		};
	};
};
