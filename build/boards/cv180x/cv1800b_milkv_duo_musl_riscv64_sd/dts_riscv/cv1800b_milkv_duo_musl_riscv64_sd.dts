/dts-v1/;
#include "cv180x_base_riscv.dtsi"
#include "cv180x_asic_qfn.dtsi"
#include "cv180x_asic_sd.dtsi"
#include "cv180x_default_memmap.dtsi"

/ {
	model = "Milk-V Duo";
};

&mipi_rx{
	snsr-reset = <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>;
};

&spi2 {
	status = "okay";

	spidev@0 {
		status = "okay";
	};
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&i2c1 {
       status = "okay";
       clock-frequency = <100000>;
};

// Below adds MAX98357A I2S speaker driver

&i2s2 {
	status = "okay";
	#sound-dai-cells = <0>;
};

&i2s0 {
	status = "okay";
	#sound-dai-cells = <0>;
};


/ {
	/* codecs */
	max98357a: max98357a {
		#sound-dai-cells = <0>;
		compatible = "maxim,max98357a";
		status = "okay";
		/*sdmode-gpios = <&gpio1 14 0>;*/ 
		/* max98357a has gain & sd_mode gpio. but codec driver just has sdmode */
	};

//	ak4553: ak4554 {
//		#sound-dai-cells = <0>;
//		compatible = "asahi-kasei,ak4554";
//		status = "okay";
//	};
	
	wm8782: wm8782 {
		#sound-dai-cells = <0>;
		compatible = "wlf,wm8782";
		status = "okay";
	};

	/* sound_extout use external dac */
	sound_extout {
		compatible = "cvitek,cv1835-max98357a";
		cvi,card_name = "cv1835_max98357a";
	};

//	sound {
//		compatible = "cvitek,cv1835-ak4554";
//		cvi,card_name = "cv1835_ak4554";
//	};

	/* sound_extin use external adc */
	sound_extin {
		compatible = "cvitek,cv1835-wm8782";
		cvi,card_name = "cv1835_wm8782";
	};

};
