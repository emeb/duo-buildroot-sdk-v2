/dts-v1/;
#include "cv180x_base_riscv.dtsi"
#include "cv180x_asic_qfn.dtsi"
#include "cv180x_asic_sd.dtsi"
#include "cv180x_default_memmap.dtsi"

/ {
	model = "Milk-V Duo";
};

&mipi_rx{
	snsr-reset = <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>;
};

&spi2 {
	status = "okay";

	/////////////////////////////////////////////////////
	// remove spidev and hook to ST7789 driver for FB use
	/////////////////////////////////////////////////////
    /delete-node/ spidev@0;

	st7789v: st7789v@0{
		compatible = "sitronix,st7789v";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <40000000>;
		spi-cpol;
		spi-cpha;
		rotate = <90>;
		fps = <30>;
		rgb;
		buswidth = <8>;

		dc-gpios = <&porte 19 GPIO_ACTIVE_HIGH>;	//DC
		reset-gpios = <&porte 20 GPIO_ACTIVE_LOW>; //RES
		led-gpios = <&porte 26 GPIO_ACTIVE_HIGH>; //BL

		debug = <0x0>;
	};
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&i2c1 {
       status = "okay";
       clock-frequency = <100000>;
};

&i2s2 {
	status = "okay";
	#sound-dai-cells = <0>;
};

&i2s0 {
	status = "okay";
	#sound-dai-cells = <0>;
};


/ {
	///////////////////////////////////////////////////////////////////////////
	// Use spdif as generic I2S and I2S2 & I2S1 in master TX/slave RX setup
	// for concurrent operation. Note that RX-only will not work.
	///////////////////////////////////////////////////////////////////////////
	codec_out: spdif-transmitter {
		#address-cells = <0>;
		#size-cells = <0>;
		#sound-dai-cells = <0>;
		compatible = "linux,spdif-dit";
		status = "okay";
	};
	
	codec_in: spdif-receiver {
		#address-cells = <0>;
		#size-cells = <0>;
		#sound-dai-cells = <0>;
		compatible = "linux,spdif-dir";
		status = "okay";
	};

	sound_spdif {
		compatible = "simple-audio-card";
		simple-audio-card,name = "i2sAudio";
		// i2s-controller = <&i2s_clk_consumer>;
		status="okay";

		capture_link: simple-audio-card,dai-link@0 {
			format = "i2s";

			// Set I2S1 as slave to I2S2
			bitclock-master = <&r_codec_dai>;
			frame-master = <&r_codec_dai>;

			r_cpu_dai: cpu {
				sound-dai = <&i2s1>;
			};

			r_codec_dai: codec {
				sound-dai = <&codec_in>;
			};
		};

		playback_link: simple-audio-card,dai-link@1 {
			format = "i2s";

			// Set I2S2 as master
			bitclock-master = <&p_cpu_dai>;
			frame-master = <&p_cpu_dai>;

			p_cpu_dai: cpu {
				sound-dai = <&i2s2>;
			};

			p_codec_dai: codec {
				sound-dai = <&codec_out>;
			};
		};
	};
	
	///////////////////////////////
	// rotary encoder with button
	///////////////////////////////
    rotary@0 {
        compatible = "rotary-encoder";
        status = "okay";
        gpios = <&porta 25 GPIO_ACTIVE_HIGH>, <&porta 22 GPIO_ACTIVE_HIGH>;
        linux,axis = <0>; /* REL_X */
        rotary-encoder,encoding = "gray";
        rotary-encoder,relative-axis;
    };
	
	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		up {
			label = "GPIO Key ENC_PB";
			linux,code = <103>;
			gpios = <&porta 26 GPIO_ACTIVE_LOW>;
		};
	};
};
